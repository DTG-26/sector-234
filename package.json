{
  "name": "xag-protocol-zero",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --port 5173",
    "build:server": "npx esbuild server/index.ts --bundle --platform=node --format=esm --outfile=dist-server/index.js --packages=external",
    "build": "tsc && vite build && npm run build:server",
    "prestart": "npm run build:server",
    "server": "node dist-server/index.js",
    "start": "node dist-server/index.js",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
